{
  "name": "estulanches",
  "version": "1.1.0",
  "description": "Sistema de cardápio e pedidos para cantina escolar",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/rodar-testes.js",
    "test:unit": "jest --runInBand tests/unit --json --outputFile=rdm/testes-unitarios.json",
    "test:integration": "jest --runInBand --forceExit tests/integration --json --outputFile=rdm/testes-integracao.json",
    "test:coverage": "jest --coverage --runInBand tests/unit",
    "validar": "node scripts/validar-ambiente.js",
    "rdm": "node scripts/rodar-rdm.js",
    "env": "node scripts/gerar-env.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pdfkit": "^0.16.0",
    "supertest": "^7.0.0"
  }
}
